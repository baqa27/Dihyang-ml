# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_A_SECURE_SECRET_KEY_HERE
WS_SECRET_TOKEN=GENERATE_A_SECURE_WS_TOKEN_HERE

# =============================================================================
# CORS SETTINGS (Production Only)
# =============================================================================
# Comma-separated list of allowed origins for production
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=10

# =============================================================================
# AI API KEYS
# =============================================================================
GEMINI_API_KEY=MASUKKAN_API_KEY_ANDA_DI_SINI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

NVIDIA_API_KEY=MASUKKAN_API_KEY_NVIDIA_ANDA_DI_SINI
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_TIMEOUT_SECONDS=15
